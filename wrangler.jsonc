{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kethmi",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only video requests go through the Worker script; everything else is served directly.
    "run_worker_first": ["/videos/*"]
  }
}
